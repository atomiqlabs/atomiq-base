{
  "name": "@atomiqlabs/base",
  "version": "13.7.0",
  "description": "Base classes and interfaces for atomiq protocol",
  "main": "./dist/index.js",
  "module": "./dist-esm/index.js",
  "types:": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/messaging/messages/SwapClaimWitnessMessage.js",
    "./dist-esm/messaging/messages/SwapClaimWitnessMessage.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist-esm/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npx -y -p typescript@4.9 tsc && npx -y -p typescript@4.9 tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist-esm/package.json', JSON.stringify({type:'module',sideEffects:['./messaging/messages/SwapClaimWitnessMessage.js']}))\"",
    "build:ts4": "npx -p typescript@4.9 tsc --noEmit",
    "build:ts5": "npx -p typescript@5.3 tsc --noEmit"
  },
  "files": [
    "/dist",
    "/dist-esm",
    "/src"
  ],
  "keywords": [
    "Solana",
    "Bitcoin",
    "Cross-chain",
    "Cryptocurrency",
    "Bridge",
    "Trustless"
  ],
  "author": "adambor",
  "license": "ISC",
  "dependencies": {
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "18.15.11",
    "typescript": ">=4"
  }
}
